# Copy to `.env`, then fill in. `.env` is gitignored; never commit real values.
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# Use the PROJECT URL and a PUBLIC key only:
#   Dashboard -> Project Settings -> API
#
# NEVER put the Postgres connection string here
#   postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
# and never put a service_role / sb_secret_ key here. Both are admin
# credentials and lib/config/supabase_config.dart rejects them.

SUPABASE_URL=https://<project-ref>.supabase.co

# Legacy anon JWT or the newer sb_publishable_... key. The alias
# SUPABASE_PUBLISHABLE_KEY is also accepted.
SUPABASE_ANON_KEY=<sb_publishable_... or anon JWT>
